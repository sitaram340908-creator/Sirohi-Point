# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/**/.env.example

# vercel
.vercel

# local Expo state
.expo/
.expo-shared/

# editor and temporary files
.idea/
.vscode/
*.swp
*.swo
*.tmp

# local databases and test artifacts
*.sqlite
*.sqlite-journal
*.db
coverage/
test-results/
playwright-report/

# typescript
next-env.d.ts
/dist/
apps/client/dist/
apps/client/.expo/
apps/api/dist/
packages/*/dist/
*.tsbuildinfo
/.wrangler/
/outputs/
/work/
